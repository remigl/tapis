# systemd user service. Install with:
#   mkdir -p ~/.config/systemd/user && cp tapis.service ~/.config/systemd/user/
#   systemctl --user enable --now tapis
# Pair a phone with:  systemctl --user stop tapis && tapis --pair
[Unit]
Description=Tapis - phone trackpad and keyboard (local network)
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/tapis
Restart=on-failure
NoNewPrivileges=true

[Install]
WantedBy=default.target
